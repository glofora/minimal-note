# ==============================================================================
# Google Drive Personal Backup (Opt-In WhatsApp Style) Configuration
# ==============================================================================

# Google Cloud OAuth 2.0 Client Credentials
# Create these in Google Cloud Console > APIs & Services > Credentials
# Application Type: Web application
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Authorized Redirect URI
# Must match exactly what is registered in Google Cloud Console
# For local development: http://localhost:3000/api/google-drive/callback
# For production: https://yourdomain.com/api/google-drive/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-drive/callback

# AES-256-GCM Encryption Key for storing Google refresh tokens securely at rest.
# Must be a 32-byte secret (64-character hexadecimal string, or any 32+ character strong secret).
# You can generate one via terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional: Next.js Public App URL (used for redirecting back to settings after OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000
